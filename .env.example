# Copy this file to backend/.env and fill in the values.

# --- Required ---

# Gemini API key for LLM-based listing field extraction (gender preference, etc.)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional ---

# SQLite database path (relative to backend/ directory). Default: ./helveti.db
# DATABASE_URL=sqlite+aiosqlite:///./helveti.db
